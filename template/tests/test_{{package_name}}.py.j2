{% set client_class = project_name.replace(" ", "").replace("-", "") %}
"""Basic tests for {{ project_name }}."""

from aresponses import ResponsesMockServer

from {{ package_name }} import {{ client_class }}
from {{ package_name }}.const import API_HOST


async def test_json_request(aresponses: ResponsesMockServer) -> None:
    """Test JSON response is handled correctly."""
    aresponses.add(
        API_HOST,
        "/api/test",
        "GET",
        aresponses.Response(
            status=200,
            headers={"Content-Type": "application/json"},
            text='{"status": "ok"}',
        ),
    )

    async with {{ client_class }}() as client:
        response = await client._request("test")

    assert response == {"status": "ok"}
